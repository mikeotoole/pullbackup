# --- paths ---
# The PULLBACKUP_ prefix is what this build reads. During the deployment
# cutover the stack may export BOTH prefixes; a retired PULLBACK_ name with no
# PULLBACKUP_ counterpart is adopted with a warning rather than silently
# reverting to a default. PULLBACKUP_ values always win.
PULLBACKUP_DATA_DIR=/data
PULLBACKUP_DEST_ROOTS=/mnt/dest/backups,/mnt/dest/media
PULLBACKUP_ZFS_DEST_ROOTS=cache/docker_remote
PULLBACKUP_MAX_CONCURRENT_RUNS=3
PULLBACKUP_HTTP_BASIC_USERNAME=
PULLBACKUP_HTTP_BASIC_PASSWORD=

# --- sessions ---
# Optional. Signs the login session cookie. When unset the key is derived from
# the credential above, so an upgrade needs no new configuration -- and
# changing the username or password invalidates every existing session. Set an
# explicit secret to rotate the password without signing everyone out.
# PULLBACKUP_SESSION_SECRET=
# How long a session lasts. Default 604800 (7 days).
# PULLBACKUP_SESSION_MAX_AGE_SECONDS=604800

# --- reverse proxy ---
# Comma-separated IP addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-For header may be believed. Empty by default, which means no
# forwarding header is trusted at all.
#
# This matters for the failed-login throttle. Behind a proxy the app sees the
# PROXY's address for every caller, so with this unset all clients share one
# failure bucket: five wrong guesses by anybody lock the login form for
# everybody for 60 seconds. Setting this gives each real client its own bucket.
#
# Only list proxies you actually control. Any host listed here can name any
# client it likes. A malformed value is refused at startup.
# PULLBACKUP_TRUSTED_PROXIES=172.18.0.0/16

# --- in-memory auth state ---
# Hard ceiling on EACH in-memory auth store: revoked sessions, and failed-login
# history. Both are bounded and expiring; this is the memory ceiling that holds
# regardless of traffic. Default 100000, roughly 10-20 MiB per store.
#
# It matters because both stores are keyed on values an unauthenticated caller
# can influence -- behind a trusted proxy the throttle key derives from
# X-Forwarded-For, so one distinct value per request is one entry.
#
# Entries that are actively enforcing a lockout are evicted LAST, so flooding
# the store cannot clear the throttle for a client that is already locked out.
# If the cap is ever reached with only live entries, a warning naming the store
# is logged rather than a revocation being dropped silently.
#
# Minimum 100; a lower value is refused at startup, the same way a malformed
# PULLBACKUP_TRUSTED_PROXIES is. A store too small to hold a locked-out client
# and a new one at the same time evicts the newcomer at every insert, which
# switches the throttle off instead of merely constraining it -- and does so
# silently, with the app still serving and the login form still working. Only
# lower this if memory is genuinely scarce; a low value is not a hardening
# measure.
# PULLBACKUP_AUTH_STORE_MAX_ENTRIES=100000

# Database filename inside PULLBACKUP_DATA_DIR. Defaults to pullback.db, which
# is the file existing deployments already hold. Leave it alone unless you are
# performing a deliberate, backed-up rename: pointing this at a new name makes
# the app create a fresh empty database and orphan every task, source, run,
# and log.
# PULLBACKUP_DB_FILENAME=pullback.db

# --- matrix (optional) ---
# omit to disable matrix checkbox in the UI
# deliberately unprefixed, matching common usage
MATRIX_HOMESERVER=
MATRIX_TOKEN=
MATRIX_ROOM_ID=

# --- uptime kuma (optional) ---
# omit to disable uptime-kuma checkbox in the UI
UPTIME_KUMA_URL=
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
