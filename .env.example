# --- paths ---
# The PULLBACKUP_ prefix is what this build reads. During the deployment
# cutover the stack may export BOTH prefixes; a retired PULLBACK_ name with no
# PULLBACKUP_ counterpart is adopted with a warning rather than silently
# reverting to a default. PULLBACKUP_ values always win.
PULLBACKUP_DATA_DIR=/data
PULLBACKUP_DEST_ROOTS=/mnt/dest/backups,/mnt/dest/media
PULLBACKUP_ZFS_DEST_ROOTS=cache/docker_remote
PULLBACKUP_MAX_CONCURRENT_RUNS=1
PULLBACKUP_HTTP_BASIC_USERNAME=
PULLBACKUP_HTTP_BASIC_PASSWORD=

# --- sessions ---
# Optional. Signs the login session cookie. When unset the key is derived from
# the credential above, so an upgrade needs no new configuration -- and
# changing the username or password invalidates every existing session. Set an
# explicit secret to rotate the password without signing everyone out.
# PULLBACKUP_SESSION_SECRET=
# How long a session lasts. Default 604800 (7 days).
# PULLBACKUP_SESSION_MAX_AGE_SECONDS=604800

# Database filename inside PULLBACKUP_DATA_DIR. Defaults to pullback.db, which
# is the file existing deployments already hold. Leave it alone unless you are
# performing a deliberate, backed-up rename: pointing this at a new name makes
# the app create a fresh empty database and orphan every task, source, run,
# and log.
# PULLBACKUP_DB_FILENAME=pullback.db

# --- matrix (optional) ---
# omit to disable matrix checkbox in the UI
# deliberately unprefixed, matching common usage
MATRIX_HOMESERVER=
MATRIX_TOKEN=
MATRIX_ROOM_ID=

# --- uptime kuma (optional) ---
# omit to disable uptime-kuma checkbox in the UI
UPTIME_KUMA_URL=
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
